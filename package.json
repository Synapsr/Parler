{
  "name": "parler",
  "private": true,
  "version": "0.1.5",
  "description": "Open-source voice dictation for macOS, Windows and Linux: hold a shortcut, speak, and your words are typed in any app. Cloud speech-to-text with Groq, OpenAI, Fireworks or any Whisper-compatible API.",
  "keywords": [
    "dictation",
    "speech-to-text",
    "voice-typing",
    "voice-to-text",
    "transcription",
    "whisper",
    "groq",
    "openai",
    "tauri",
    "macos",
    "windows",
    "linux"
  ],
  "homepage": "https://parler.synapsr.io",
  "bugs": {
    "url": "https://github.com/Synapsr/Parler/issues",
    "email": "parler@synapsr.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synapsr/Parler.git"
  },
  "license": "MIT",
  "author": "Synapsr",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tauri-plugin-macos-permissions-api": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
