<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Signing with a Developer ID turns on the hardened runtime, which
         silently denies the microphone to a process without this entitlement.
         NSMicrophoneUsageDescription in Info.plist is only the prompt text. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
