{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Parler",
  "version": "0.1.0",
  "identifier": "app.synapsr.parler",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Parler",
        "width": 460,
        "height": 700,
        "minWidth": 400,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Dictate anywhere with a Whisper-compatible cloud API",
    "longDescription": "Parler turns your voice into text in any app. Hold a shortcut, speak, let go: your words are transcribed by Groq, OpenAI, Fireworks or any Whisper-compatible API and typed where your cursor is.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
